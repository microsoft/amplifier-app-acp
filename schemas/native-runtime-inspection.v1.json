{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/amplifier-acp/schemas/native-runtime-inspection.v1.json",
  "description": "Arguments for resident-only runtime.inspect; no client process/path authority.",
  "type": "object",
  "properties": {
    "refresh": {
      "type": "boolean"
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "expectedRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "surface": {
      "enum": [
        "distributions",
        "mounted"
      ]
    }
  },
  "additionalProperties": false
}
