{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed native managed allocation file disposal",
  "description": "Requires exact original native creation proof, Foundation historical identity support, actual family ownership and separate product reference-owner protection. Does not destroy canonical history.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "managedFiles.preview"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        }
      },
      "required": [
        "sessionId",
        "cwd",
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "managedFiles.dispose"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "reviewId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "reviewHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "expectedHistoryRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "descendants": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "parentSessionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "sessionId",
                  "cwd",
                  "parentSessionId"
                ]
              }
            }
          },
          "required": [
            "commandId",
            "reviewId",
            "reviewHash",
            "expectedHistoryRevision"
          ]
        }
      },
      "required": [
        "sessionId",
        "cwd",
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "managedFiles.receipt"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "commandId"
          ]
        }
      },
      "required": [
        "sessionId",
        "cwd",
        "operation",
        "args"
      ]
    }
  ]
}
