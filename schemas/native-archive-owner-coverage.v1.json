{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/amplifier-acp/schemas/native-archive-owner-coverage.v1.json",
  "description": "Additive selected native-store coverage. This never establishes complete native or product backup. Other file coverage remains in the immutable archive manifest.",
  "type": "object",
  "required": [
    "included",
    "omitted",
    "completeNativeBackup",
    "completeProductBackup"
  ],
  "additionalProperties": false,
  "properties": {
    "included": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "part",
          "owner",
          "sourceRevision",
          "scope",
          "format",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "part": {
            "enum": [
              "native-import-records",
              "native-preference-receipts",
              "native-maintenance-records",
              "native-retained-archives",
              "native-recording-receipts"
            ]
          },
          "owner": {
            "enum": [
              "native-history-import",
              "native-voice-preferences",
              "native-maintenance",
              "native-provider-recording"
            ]
          },
          "sourceRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "enum": [
              "all-records-in-configured-native-app-home",
              "pre-existing-records-in-configured-native-app-home"
            ]
          },
          "format": {
            "enum": [
              "sqlite-backup-image",
              "owner-snapshot-tree"
            ]
          },
          "status": {
            "enum": [
              "included",
              "missing"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tables": {
            "type": "object",
            "maxProperties": 2,
            "additionalProperties": false,
            "properties": {
              "commands": {
                "type": "integer",
                "minimum": 0
              },
              "uploads": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "databaseImages": {
            "type": "integer",
            "minimum": 0
          },
          "cutoff": {
            "type": "object",
            "required": [
              "capturedAt",
              "phase",
              "excludedPlanId",
              "prepareCommandId",
              "currentPrepareReceipt",
              "artifactBodies"
            ],
            "additionalProperties": false,
            "properties": {
              "capturedAt": {
                "type": "number"
              },
              "phase": {
                "const": "before-current-plan-seal"
              },
              "excludedPlanId": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "prepareCommandId": {
                "type": "string",
                "maxLength": 200
              },
              "currentPrepareReceipt": {
                "const": "running-is-uncertain-never-replay"
              },
              "artifactBodies": {
                "enum": [
                  "included",
                  "not-selected"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "included"
                },
                "format": {
                  "const": "sqlite-backup-image"
                }
              }
            },
            "then": {
              "required": [
                "bytes",
                "sha256",
                "tables"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "format": {
                  "const": "owner-snapshot-tree"
                }
              }
            },
            "then": {
              "required": [
                "bytes",
                "files",
                "databaseImages",
                "cutoff"
              ]
            }
          }
        ]
      }
    },
    "omitted": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "owner",
          "reason",
          "preventsCompleteNativeCoverage"
        ],
        "additionalProperties": false,
        "properties": {
          "owner": {
            "enum": [
              "native-history-import",
              "native-voice-preferences",
              "native-maintenance",
              "native-provider-recording"
            ]
          },
          "part": {
            "enum": [
              "native-import-records",
              "native-preference-receipts",
              "native-maintenance-records",
              "native-retained-archives",
              "native-recording-receipts"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "preventsCompleteNativeCoverage": {
            "const": true
          },
          "classification": {
            "const": "authoritative"
          }
        }
      }
    },
    "completeNativeBackup": {
      "const": false
    },
    "completeProductBackup": {
      "const": false
    },
    "authoritativeScope": {
      "const": "explicit-selected-native-only"
    },
    "transientExclusions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "derivedExclusions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "authoritativeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalHistory",
        "sessionState",
        "sharedConfiguration",
        "workspaceConfiguration",
        "privateStores",
        "runtimeGenerationAuthority",
        "workspaceAndModuleSources"
      ],
      "properties": {
        "canonicalHistory": {
          "enum": [
            "explicit-session-ids-only",
            "not-selected"
          ]
        },
        "sessionState": {
          "enum": [
            "explicit-session-ids-only",
            "not-selected"
          ]
        },
        "sharedConfiguration": {
          "enum": [
            "selected",
            "not-selected"
          ]
        },
        "workspaceConfiguration": {
          "enum": [
            "explicit-workspaces-only",
            "not-selected"
          ]
        },
        "privateStores": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {
            "enum": [
              "native-import-records",
              "native-preference-receipts",
              "native-maintenance-records",
              "native-retained-archives",
              "native-recording-receipts"
            ]
          }
        },
        "runtimeGenerationAuthority": {
          "const": "not-covered"
        },
        "workspaceAndModuleSources": {
          "const": "not-covered"
        }
      }
    }
  }
}
