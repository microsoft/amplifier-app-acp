{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private native transfer lifecycle v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "inspect"
        },
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false,
          "required": []
        }
      },
      "required": [
        "operation",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "acquire"
        },
        "args": {
          "type": "object",
          "properties": {
            "fenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "instanceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "dataScope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "purpose": {
              "enum": [
                "recovery",
                "distribution-update",
                "service-stop"
              ]
            },
            "serviceIdentity": {
              "$ref": "#/$defs/serviceIdentity"
            }
          },
          "additionalProperties": false,
          "required": [
            "fenceId",
            "commandId",
            "instanceId",
            "dataScope",
            "purpose"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "service-stop"
                  }
                }
              },
              "then": {
                "required": [
                  "serviceIdentity"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "serviceIdentity"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "release"
        },
        "args": {
          "type": "object",
          "properties": {
            "fenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "instanceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "dataScope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "purpose": {
              "enum": [
                "recovery",
                "distribution-update",
                "service-stop"
              ]
            },
            "outcome": {
              "enum": [
                "unchanged",
                "ready",
                "unknown"
              ]
            },
            "proof": {
              "type": "object"
            },
            "serviceIdentity": {
              "$ref": "#/$defs/serviceIdentity"
            }
          },
          "additionalProperties": false,
          "required": [
            "fenceId",
            "commandId",
            "instanceId",
            "dataScope",
            "purpose",
            "outcome"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "service-stop"
                  }
                }
              },
              "then": {
                "required": [
                  "serviceIdentity"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "serviceIdentity"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "serviceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installationId",
        "dataScope",
        "ownerId",
        "instanceId",
        "releaseDigest"
      ],
      "properties": {
        "installationId": {
          "$ref": "#/$defs/token"
        },
        "dataScope": {
          "$ref": "#/$defs/token"
        },
        "ownerId": {
          "$ref": "#/$defs/token"
        },
        "instanceId": {
          "$ref": "#/$defs/token"
        },
        "releaseDigest": {
          "$ref": "#/$defs/token"
        }
      }
    }
  }
}
