{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/amplifier-acp/schemas/native-cache-maintenance.v1.json",
  "description": "Launcher-authorized cold cache inspection. Source roots are always preserved; clear only removes exact reconstructible bytecode under a held recovery admin and exclusive native writer gate. No Core/model/network calls.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "cwd",
        "operation",
        "args"
      ],
      "properties": {
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "maintenance.cache.scan"
        },
        "args": {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "commandId"
          ],
          "additionalProperties": false
        },
        "_meta": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "cwd",
        "operation",
        "args"
      ],
      "properties": {
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "maintenance.cache.page"
        },
        "args": {
          "type": "object",
          "properties": {
            "scanId": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "cursor": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "scanId",
            "revision"
          ],
          "additionalProperties": false
        },
        "_meta": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "cwd",
        "operation",
        "args"
      ],
      "properties": {
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "maintenance.cache.preview"
        },
        "args": {
          "type": "object",
          "properties": {
            "scanId": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              }
            },
            "reviewed": {
              "const": true
            }
          },
          "required": [
            "scanId",
            "revision",
            "ids",
            "reviewed"
          ],
          "additionalProperties": false
        },
        "_meta": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "cwd",
        "operation",
        "args"
      ],
      "properties": {
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "maintenance.cache.clear"
        },
        "args": {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "previewHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "commandId",
            "previewHash"
          ],
          "additionalProperties": false
        },
        "_meta": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  ]
}
