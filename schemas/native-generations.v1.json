{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native generation administration v1",
  "type": "object",
  "properties": {
    "cwd": {
      "type": "string",
      "description": "Trusted launcher-authorized workspace, not client-selected authority"
    },
    "operation": {
      "enum": [
        "generations.inspect",
        "generations.check",
        "generations.prepare",
        "generations.promote",
        "generations.rollback",
        "generations.receipt",
        "generations.launcher",
        "generations.ensure"
      ]
    },
    "args": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "expectedCurrent": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkId": {
          "type": "string"
        },
        "nativeSessionId": {
          "type": "string"
        },
        "bundle": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "cwd",
    "operation",
    "args"
  ],
  "additionalProperties": false
}
