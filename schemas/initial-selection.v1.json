{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microsoft/amplifier-app-acp/schemas/initial-selection.v1.json",
  "title": "Negotiated native initial selection v1",
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance",
        "model"
      ],
      "properties": {
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "typedSelection",
        "passive",
        "resolveMethod"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "typedSelection": {
          "const": true
        },
        "passive": {
          "const": true
        },
        "resolveMethod": {
          "const": "_amplifier/initial-selection"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "selection"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      }
    },
    "partialSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "resolveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cwd"
      ],
      "properties": {
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "selection": {
          "$ref": "#/$defs/partialSelection"
        }
      }
    },
    "resolveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "schema",
        "values"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "values": {
          "allOf": [
            {
              "$ref": "#/$defs/partialSelection"
            },
            {
              "required": [
                "instance"
              ]
            }
          ]
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "additionalProperties",
            "required",
            "properties"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "additionalProperties": {
              "const": false
            },
            "required": {
              "const": [
                "instance",
                "model"
              ]
            },
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "instance",
                "model"
              ],
              "properties": {
                "instance": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "title",
                    "enum"
                  ],
                  "properties": {
                    "type": {
                      "const": "string"
                    },
                    "enum": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                },
                "model": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "title",
                    "enum"
                  ],
                  "properties": {
                    "type": {
                      "const": "string"
                    },
                    "enum": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1000,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                },
                "effort": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "title",
                    "enum"
                  ],
                  "properties": {
                    "type": {
                      "const": "string"
                    },
                    "enum": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
