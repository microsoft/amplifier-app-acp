{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microsoft/amplifier-app-acp/schemas/launcher-source-closure.v1.json",
  "title": "Trusted launch source closure v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "sha256"
  ],
  "properties": {
    "path": {
      "type": "string",
      "maxLength": 4096
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sources"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedUri",
        "basePath",
        "activePath",
        "sourceRoot",
        "resolvedCommit",
        "approval",
        "files",
        "admissionFiles",
        "packages"
      ],
      "properties": {
        "requestedUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "basePath": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "activePath": {
          "type": "string",
          "maxLength": 4096
        },
        "sourceRoot": {
          "type": "string",
          "maxLength": 4096
        },
        "resolvedCommit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "approval": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "files": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 65536,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "admissionFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "packages": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "manifestSha256",
        "sourceResolution"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceResolution": {
          "const": "qualified-only",
          "type": "string"
        }
      }
    }
  }
}
