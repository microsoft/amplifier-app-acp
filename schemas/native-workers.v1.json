{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/amplifier-acp/schemas/native-workers.v1.json",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "maxLength": 200
    },
    "cwd": {
      "type": "string",
      "maxLength": 8192
    },
    "workerId": {
      "type": "string",
      "maxLength": 200
    },
    "cursor": {
      "type": "string",
      "maxLength": 200
    },
    "commandId": {
      "type": "string",
      "maxLength": 200
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "afterSequence": {
      "type": "integer",
      "minimum": 0
    },
    "resultLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    }
  },
  "required": [
    "sessionId",
    "cwd"
  ],
  "additionalProperties": false
}
