{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Passive selected native session lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "cwd",
    "operation"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 221
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "inspect",
        "receipt",
        "fork",
        "export",
        "export.read",
        "delete.preview",
        "delete",
        "restore",
        "retention.hide",
        "legacyCopy.inventory",
        "legacyCopy.preview",
        "legacyCopy.purge",
        "legacyCopy.receipt",
        "managedFiles.preview",
        "managedFiles.dispose",
        "managedFiles.receipt"
      ]
    },
    "args": {
      "type": "object",
      "description": "See docs/session-lifecycle.md for per-operation bounds and immutable receipt semantics."
    }
  },
  "$defs": {
    "forkArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "targetSessionId",
        "expectedHistoryRevision"
      ],
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "targetSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 221
        },
        "expectedHistoryRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "throughMessageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "bundle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bundleRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "mode": {
          "enum": [
            "complete",
            "recovery"
          ]
        },
        "resetModel": {
          "type": "boolean"
        },
        "descendants": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "sessionId",
              "cwd",
              "parentSessionId"
            ],
            "additionalProperties": false,
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 221
              },
              "parentSessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 221
              },
              "cwd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      }
    },
    "retentionArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "expectedHistoryRevision",
        "modifiedBefore",
        "descendants"
      ],
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expectedHistoryRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "descendants": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "sessionId",
              "cwd",
              "parentSessionId"
            ],
            "additionalProperties": false,
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 221
              },
              "parentSessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 221
              },
              "cwd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "modifiedBefore": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "exportContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source",
        "work",
        "artifacts",
        "omissions"
      ],
      "description": "Optional bounded observation data from the authorized Host; not canonical history or execution authority. Maximum serialized size 1 MiB.",
      "properties": {
        "version": {
          "const": 1
        },
        "source": {
          "const": "host-retained-observations"
        },
        "work": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "anchor",
              "status",
              "toolCalls",
              "modelCalls"
            ],
            "properties": {
              "anchor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "status": {
                "enum": [
                  "completed",
                  "cancelled",
                  "error",
                  "unknown"
                ]
              },
              "toolCalls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "modelCalls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "durationSeconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 31536000
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "messageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "omissions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z_]+$"
          }
        }
      }
    },
    "exportArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "expectedHistoryRevision",
        "format"
      ],
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expectedHistoryRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "format": {
          "enum": [
            "markdown",
            "json"
          ]
        },
        "scope": {
          "enum": [
            "all",
            "from",
            "range"
          ]
        },
        "fromMessageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "throughMessageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "minimal": {
          "type": "boolean"
        },
        "includeExecution": {
          "type": "boolean"
        },
        "includeConversationId": {
          "type": "boolean"
        },
        "includeTimestamps": {
          "type": "boolean"
        },
        "includeReferenceIds": {
          "type": "boolean"
        },
        "exportContext": {
          "$ref": "#/$defs/exportContext"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "fork"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/forkArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "retention.hide"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/retentionArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "export"
          }
        }
      },
      "then": {
        "required": [
          "args"
        ],
        "properties": {
          "args": {
            "$ref": "#/$defs/exportArgs"
          }
        }
      }
    }
  ]
}
